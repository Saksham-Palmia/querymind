# Copy to .env and supply a key for your selected provider.
# These database credentials are for the local Docker sample only.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

POSTGRES_DB=ecommerce
POSTGRES_USER=admin
POSTGRES_PASSWORD=querymind_local
DATABASE_URL=postgresql://admin:querymind_local@postgres:5432/ecommerce
CHROMA_URL=http://chromadb:8000

# For a backend running outside Docker use localhost instead:
# DATABASE_URL=postgresql://admin:querymind_local@localhost:5432/ecommerce
# CHROMA_URL=http://localhost:8001

# Optional: persistent embedded Chroma instead of a Chroma server.
# CHROMA_PERSIST_DIR=./chroma_data
